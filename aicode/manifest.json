{
  "manifest_version": 3,
  "name": "DOM Action Recorder for Grok AI",
  "version": "0.1.0",
  "description": "JBOT.",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }],
  "options_page": "options.html"
}
